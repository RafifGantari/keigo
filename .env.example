# ==============================================================================
# KEIGO ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local (for Next.js) or .env (for Python & automation)
# NEVER commit real API keys or service role secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Cloud Database & Storage)
# ------------------------------------------------------------------------------
# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (safe for client-side Next.js reading)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Secret Key (KEEP SECRET! Used only by Python & n8n locally)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Storage bucket for cover banners and Instagram cards
SUPABASE_MEDIA_BUCKET=media-assets

# ------------------------------------------------------------------------------
# 2. 9ROUTER AI GATEWAY (Local AI Proxy to Free-Tier Providers)
# ------------------------------------------------------------------------------
# 9Router local endpoint (OpenAI-compatible)
ROUTER_BASE_URL=http://localhost:8080/v1
ROUTER_API_KEY=your-9router-local-key

# Primary & Fallback Free-Tier Models
AI_MODEL_FAST=gemini-2.0-flash
AI_MODEL_REASONING=gemini-2.0-flash-thinking
AI_MODEL_FALLBACK=groq/llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 3. INSTAGRAM & META GRAPH API
# ------------------------------------------------------------------------------
# Facebook Page / Instagram Professional Account ID
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# Long-lived Meta Page Access Token (with pages_show_list, instagram_basic, instagram_content_publish permissions)
META_PAGE_ACCESS_TOKEN=EAAG...

# Meta Graph API Version
META_GRAPH_VERSION=v21.0

# ------------------------------------------------------------------------------
# 4. APPLICATION & GENERAL
# ------------------------------------------------------------------------------
# Environment mode: development or production
NODE_ENV=development

# Canonical Public Website URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_NAME="KEIGO"
SITE_TAGLINE="Curiosity. Clarity. Discovery."
